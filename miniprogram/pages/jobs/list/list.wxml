<upload-float />
<view class="container">
  <view class="card head">
    <view class="section-title">任务中心</view>
    <view class="muted">业主视角的任务：宣传生图 / 宣传视频。点开看进度与素材槽位；分析图、发品、封面等系统任务不展示。</view>
  </view>

  <scroll-view scroll-x class="chips-row" enable-flex>
    <text
      class="chip {{status===item.id?'active':''}}"
      wx:for="{{statusChips}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onStatus"
    >{{item.name}}</text>
  </scroll-view>
  <scroll-view scroll-x class="chips-row" enable-flex>
    <text
      class="chip {{type===item.id?'active':''}}"
      wx:for="{{typeChips}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onType"
    >{{item.name}}</text>
  </scroll-view>

  <view class="card muted" wx:if="{{loading && !list.length}}">加载中…</view>
  <view class="card muted empty" wx:elif="{{!list.length}}">
    <view>还没有宣传任务</view>
    <view class="muted small" style="margin-top:8rpx;">去商品列表点「素材」→「新建素材」开始生图或视频</view>
  </view>

  <view class="card job" wx:for="{{list}}" wx:key="id">
    <view class="job-row">
      <image
        class="thumb"
        wx:if="{{item.productThumb}}"
        src="{{item.productThumb}}"
        mode="aspectFill"
        lazy-load
      />
      <view class="thumb thumb-ph" wx:else>
        <text>{{item.styleNo ? item.styleNo.slice(0, 4) : '货'}}</text>
      </view>

      <view class="job-main">
        <view class="job-title-block" data-id="{{item.id}}" data-product-id="{{item.productId}}" data-set-id="{{item.setId}}" data-is-gen="{{item.isGenType}}" bindtap="openView">
          <text class="job-title">{{item.title}}</text>
          <text class="muted small" wx:if="{{item.styleNo}}">款号 {{item.styleNo}}</text>
          <text class="muted small" wx:elif="{{item.createdText}}">{{item.createdText}}</text>
        </view>

        <view class="job-foot">
          <view class="foot-left">
            <text class="st st-{{item.tone}}">{{item.statusLabel}}</text>
            <text class="muted small" wx:if="{{item.busyHint}}">{{item.busyHint}}</text>
            <text class="err-hint" wx:elif="{{item.errHint}}">{{item.errHint}}</text>
          </view>
          <view class="foot-ops">
            <text class="link" wx:if="{{item.canView}}" data-id="{{item.id}}" data-product-id="{{item.productId}}" data-set-id="{{item.setId}}" data-is-gen="{{item.isGenType}}" bindtap="openView">查看</text>
            <text class="link" wx:if="{{item.canCancel}}" data-id="{{item.id}}" catchtap="cancel">{{item.cancelLabel}}</text>
            <text class="link primary retry" wx:if="{{item.canRetry}}" data-id="{{item.id}}" catchtap="retry">{{item.retryLabel || '重试'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card muted footer-tip" wx:if="{{loadingMore}}">加载更多…</view>
  <view class="card muted footer-tip" wx:elif="{{list.length && !hasMore}}">没有更多了</view>
  <view class="card muted footer-tip" wx:elif="{{list.length && hasMore}}">上拉加载更多</view>
</view>
