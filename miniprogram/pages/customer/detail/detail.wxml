<view class="container" wx:if="{{customer}}">
  <view class="card">
    <view>ID：{{customer.id}}</view>
    <view>openid：{{customer.openid}}</view>
    <view>姓名：{{customer.nickname || '未填'}}</view>
    <view>手机：{{customer.phone || '未填'}}</view>
    <view>等级：{{customer.levelCode}}（rank {{customer.rank}}）</view>
    <view class="muted">首次分享：{{customer.firstShareEventId || '无'}}</view>
  </view>

  <view class="card">
    <view class="section">调整等级</view>
    <picker mode="selector" range="{{levels}}" range-key="name" value="{{levelIndex}}" bindchange="onLevelPick">
      <view class="picker">{{levels[levelIndex].name || '选择等级'}}</view>
    </picker>
    <view class="btn-primary" style="margin-top: 16rpx;" bindtap="saveLevel">保存等级</view>
  </view>

  <view class="card">
    <view class="section">询价记录</view>
    <view class="fu" wx:for="{{inquiries}}" wx:key="id">
      <view>商品 {{item.productId}}</view>
      <view wx:if="{{item.contactName || item.phone}}">{{item.contactName || ''}} {{item.phone || ''}}</view>
      <view class="muted">{{item.content}}</view>
      <view class="muted">{{item.status}} · {{item.createdAt}}</view>
    </view>
    <view class="muted" wx:if="{{!inquiries.length}}">暂无询价</view>
  </view>

  <view class="card">
    <view class="section">跟进记录</view>
    <view class="fu" wx:for="{{followUps}}" wx:key="id">
      <view>{{item.content}}</view>
      <view class="muted">{{item.kind}} · {{item.createdAt}}</view>
      <text class="link danger" data-id="{{item.id}}" bindtap="removeFollow">删除</text>
    </view>
    <textarea class="input area" placeholder="写一条跟进…" value="{{followContent}}" bindinput="onFollowInput" />
    <view class="btn-primary mini" bindtap="addFollow">添加跟进</view>
  </view>

  <view class="card">
    <view class="section">商品例外规则</view>
    <view class="fu" wx:for="{{rules}}" wx:key="id">
      <view>{{item.effect}} → 商品 {{item.productId}}</view>
      <text class="link danger" data-id="{{item.id}}" bindtap="removeRule">删除</text>
    </view>
    <input class="input" placeholder="商品 ID" value="{{ruleProductId}}" bindinput="onRuleProduct" />
    <radio-group bindchange="onRuleEffect">
      <label><radio value="allow" checked="{{ruleEffect==='allow'}}"/>允许</label>
      <label style="margin-left: 24rpx;"><radio value="deny" checked="{{ruleEffect==='deny'}}"/>禁止</label>
    </radio-group>
    <view class="btn-primary mini" bindtap="saveRule">保存规则</view>
  </view>
</view>
