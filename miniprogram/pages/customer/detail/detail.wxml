<view class="container" wx:if="{{customer}}">
  <!-- 上半：联系方式 -->
  <view class="card contact-card">
    <view class="section-title">联系方式</view>
    <view class="contact-name">{{contact.name}}</view>
    <view class="contact-phone">{{contact.phone}}</view>
    <view class="muted tip" wx:if="{{!contact.hasContact}}">客户尚未留下姓名或手机；可看下方询价记录里的快照</view>
    <view class="btn-primary copy-btn" bindtap="copyContact" wx:if="{{contact.hasContact}}">一键复制联系方式</view>
    <view class="btn-ghost copy-btn disabled" wx:else>暂无可复制联系方式</view>
  </view>

  <!-- 询价记录 -->
  <view class="card">
    <view class="section-title">询价记录</view>
    <view class="section-hint">点「已处理」并填写处理方式；复制上方联系方式去微信沟通即可</view>

    <view class="inq" wx:for="{{inquiries}}" wx:key="id">
      <view class="inq-head">
        <text class="inq-product">{{item.productTitle}}</text>
        <text class="inq-status {{item.isHandled ? 'done' : 'open'}}">{{item.statusLabel}}</text>
      </view>
      <view class="muted small">{{item.timeText}}</view>
      <view class="inq-contact" wx:if="{{item.contactSnap}}">联系快照：{{item.contactSnap}}</view>
      <view class="inq-body" wx:if="{{item.remarkText}}">备注：{{item.remarkText}}</view>
      <view class="inq-body muted" wx:elif="{{item.contentText}}">{{item.contentText}}</view>
      <view class="inq-handled" wx:if="{{item.isHandled && item.handledNote}}">处理说明：{{item.handledNote}}</view>

      <block wx:if="{{!item.isHandled}}">
        <input
          class="input handle-input"
          placeholder="处理方式（如：已微信报价 / 已电话沟通）"
          value="{{handleDrafts[item.id]}}"
          data-id="{{item.id}}"
          bindinput="onHandleNoteInput"
        />
        <view class="btn-primary mini" data-id="{{item.id}}" bindtap="markHandled">标记已处理</view>
      </block>
    </view>
    <view class="muted empty-tip" wx:if="{{!inquiries.length}}">暂无询价</view>
  </view>

  <!-- 访问过的商品 -->
  <view class="card">
    <view class="section-title">访问过的商品</view>
    <view class="section-hint">来自分享打开/浏览记录；点进可看商品详情</view>
    <view class="visit-row" wx:for="{{viewedProducts}}" wx:key="productId" data-id="{{item.productId}}" bindtap="goProduct">
      <view class="visit-body">
        <view class="visit-title">{{item.title}}</view>
        <view class="muted small">{{item.timeText}} <text wx:if="{{item.countText}}">· {{item.countText}}</text></view>
      </view>
      <view class="arrow muted">›</view>
    </view>
    <view class="muted empty-tip" wx:if="{{!viewedProducts.length}}">暂无访问记录</view>
  </view>

  <!-- 跟进备忘 -->
  <view class="card">
    <view class="section-title">跟进备忘</view>
    <view class="section-hint">记下哪天跟客户聊了什么，方便以后回顾</view>

    <view class="fu" wx:for="{{followUps}}" wx:key="id">
      <view class="fu-content">{{item.content}}</view>
      <view class="fu-meta">
        <text class="muted">{{item.timeText}}</text>
        <text class="link danger" data-id="{{item.id}}" bindtap="removeFollow">删除</text>
      </view>
    </view>
    <view class="muted empty-tip" wx:if="{{!followUps.length}}">暂无备忘</view>

    <textarea
      class="input area"
      placeholder="写一条跟进备忘…"
      value="{{followContent}}"
      bindinput="onFollowInput"
      maxlength="500"
    />
    <view class="btn-primary mini" bindtap="addFollow">添加备忘</view>
  </view>
</view>
