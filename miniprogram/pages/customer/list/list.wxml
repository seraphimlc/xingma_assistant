<upload-float />
<view class="container">
  <view class="card head">
    <view class="section-title">客户</view>
    <view class="muted">分享打开后自动建档；有待处理询价时行上会显示红点；已处理不再提示</view>
  </view>

  <view class="card search-bar">
    <input class="input" placeholder="搜索姓名 / 手机" value="{{q}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <scroll-view scroll-x class="chips-row" enable-flex>
    <text
      class="chip {{filter===item.id?'active':''}}"
      wx:for="{{filterChips}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onFilter"
    >{{item.name}}</text>
  </scroll-view>

  <view class="card muted" wx:if="{{loading && !list.length}}">加载中…</view>
  <view class="card muted empty" wx:elif="{{!list.length}}">
    <view wx:if="{{filter==='pending'}}">暂无待处理询价</view>
    <block wx:else>
      <view>还没有客户</view>
      <view class="muted small" style="margin-top:8rpx;">去商品列表点「转发」，对方打开后会自动出现在这里</view>
    </block>
  </view>

  <view class="card row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="avatar-wrap">
      <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-ph">{{item.nickShort}}</view>
      <view wx:if="{{item.showDot}}" class="row-dot {{item.hasUnreadInquiry ? 'unread' : ''}}"></view>
    </view>
    <view class="body">
      <view class="name-line">
        <text class="name">{{item.displayName}}</text>
        <text wx:if="{{item.hasUnreadInquiry}}" class="badge-unread">新询价</text>
        <text wx:elif="{{item.showInquiryBadge}}" class="badge-inq">待处理 {{item.pendingInquiryCount || ''}}</text>
      </view>
      <view class="muted small">{{item.contactLine}}</view>
    </view>
    <view class="arrow muted">›</view>
  </view>
</view>

  <view class="card muted footer-tip" wx:if="{{loadingMore}}">加载更多…</view>
  <view class="card muted footer-tip" wx:elif="{{list.length && !hasMore}}">没有更多了</view>
  <view class="card muted footer-tip" wx:elif="{{list.length && hasMore}}">上拉加载更多</view>
