.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.img-cell {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #f0ebe6;
}
.img-cell .thumb { width: 100%; height: 100%; }
.img-cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e0b8a0;
  background: #fffaf7;
}
.img-cell.add.disabled { opacity: 0.5; }
.add-plus { font-size: 48rpx; color: #c45c26; line-height: 1; }
.add-txt { font-size: 22rpx; color: #8a8a8a; margin-top: 4rpx; }
.img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0,0,0,.55);
  color: #fff;
  font-size: 28rpx;
}
.img-mark {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0,0,0,.5);
  color: #fff;
}

.note-box {
  min-height: 520rpx;
  max-height: 70vh;
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}
.note-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  justify-content: flex-end;
}
.note-btn {
  flex: 1;
  max-width: 320rpx;
  padding: 20rpx 24rpx;
}
.note-btn.disabled { opacity: 0.45; pointer-events: none; }

.img-cell.sortable.is-dragging {
  opacity: 0.55;
  transform: scale(1.06);
  box-shadow: 0 8rpx 24rpx rgba(196, 92, 38, 0.35);
  z-index: 2;
}
.img-cell.sortable.is-over {
  outline: 4rpx solid #c45c26;
  outline-offset: -4rpx;
  background: #fff0e8;
}
.img-cover-badge {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(196, 92, 38, 0.92);
  color: #fff;
}

/* 待补全：款号行 + 拍吊牌识别入口 */
.style-row { display: flex; align-items: center; gap: 16rpx; }
.style-row .style-input { flex: 1; }
.hangtag-btn {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  background: #c45c26;
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}
.hangtag-btn.disabled { opacity: 0.6; }
.field-warn {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #c45c26;
  background: rgba(196, 92, 38, 0.08);
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
}
