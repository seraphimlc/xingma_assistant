<view class="container">
  <view class="card head" wx:if="{{product}}">
    <view class="section-title">{{product.name || '宣传素材'}}</view>
    <view class="muted">款号 {{product.styleNo}} · 图组与视频组同列表</view>
  </view>

  <view class="card muted" wx:if="{{loading && !sets.length}}">加载中…</view>
  <view class="card muted empty" wx:elif="{{!sets.length}}">
    <view>暂无宣传素材</view>
    <view class="muted small" style="margin-top:8rpx;">可新建宣传图或竖版短视频</view>
    <view class="btn-primary" style="margin-top:24rpx;" bindtap="goGenerate">新建素材</view>
  </view>

  <view class="card job" id="set-{{item.id}}" wx:for="{{sets}}" wx:key="id">
    <view class="job-head">
      <view class="job-head-main" data-id="{{item.id}}" bindtap="toggleExpand">
        <view>
          <text class="type-badge">{{item.typeLabel}}</text>
          <text class="job-name">{{item.templateName}}</text>
          <text class="st {{item.busy ? 'run' : (item.status==='failed' ? 'err' : 'ok')}}">{{item.statusLabel}}</text>
        </view>
        <view class="muted small">{{item.isVideo ? (item.done + '/' + item.total + ' 条') : (item.done + ' / ' + item.total + ' 张')}} · {{item.expanded ? '收起' : '展开查看'}}</view>
        <view class="muted small" wx:if="{{item.progressText}}">{{item.progressText}}</view>
      </view>
      <text
        class="job-del"
        wx:if="{{!item.busy}}"
        data-id="{{item.id}}"
        catchtap="deleteSet"
      >{{actingId === item.id ? '…' : '删除'}}</text>
    </view>

    <view class="bar-wrap" wx:if="{{item.busy}}">
      <view class="bar"><view class="bar-fill" style="width: {{item.percent}}%;"></view></view>
    </view>

    <block wx:if="{{item.expanded || item.busy || item.done || item.status==='partial'}}">
      <view class="album-bar" wx:if="{{item.done || item.status==='partial'}}">
        <text class="link" data-id="{{item.id}}" bindtap="toggleSelectAllAlbum">{{item.albumAllSelected ? '取消全选' : '全选'}}</text>
        <text class="muted small">勾选图片后，用下方按钮下载或重新生成 · 点图可预览</text>
      </view>

      <view class="video-wrap" wx:if="{{item.isVideo && item.videoUrl}}">
        <video
          class="promo-video"
          src="{{item.videoUrl}}"
          controls
          show-center-play-btn
          object-fit="contain"
          poster=""
        ></video>
        <view class="album-bar" style="margin-top:12rpx;">
          <text
            class="check {{item.items[0].albumSelected ? 'on' : ''}}"
            data-setid="{{item.id}}"
            data-index="0"
            catchtap="toggleAlbumItem"
          >{{item.items[0].albumSelected ? '✓ 已选' : '勾选以下载'}}</text>
        </view>
      </view>
      <view class="grid" wx:elif="{{item.items.length}}">
        <view class="cell {{im.albumSelected ? 'checked' : ''}}" wx:for="{{item.items}}" wx:for-item="im" wx:for-index="idx" wx:key="index">
          <image
            wx:if="{{im.url}}"
            src="{{im.url}}"
            mode="aspectFill"
            lazy-load
            data-setid="{{item.id}}"
            data-index="{{idx}}"
            bindtap="preview"
          />
          <view class="placeholder" wx:elif="{{im.failed}}">失败</view>
          <view class="placeholder" wx:else>生成中…</view>
          <view
            class="check {{im.albumSelected ? 'on' : ''}}"
            wx:if="{{im.url}}"
            data-setid="{{item.id}}"
            data-index="{{idx}}"
            catchtap="toggleAlbumItem"
          >{{im.albumSelected ? '✓' : ''}}</view>
        </view>
      </view>
      <view class="muted small" wx:elif="{{item.busy}}">排队或执行中，完成后自动刷新</view>

      <!-- 紧挨图片：下载 + 重新生成 -->
      <view class="media-actions" wx:if="{{!item.busy && (item.done || item.status==='partial')}}">
        <view
          class="btn-primary media-btn"
          data-id="{{item.id}}"
          bindtap="saveToAlbum"
        >{{savingAlbumId === item.id ? '保存中…' : item.albumSaveLabel}}</view>
        <view
          class="btn-ghost media-btn"
          data-id="{{item.id}}"
          bindtap="regenSelected"
        >{{actingId === item.id ? '提交中…' : item.regenLabel}}</view>
      </view>

      <view class="caption-box" wx:if="{{item.hasCaption && (item.done || item.status==='partial')}}">
        <view class="caption-head">
          <text class="caption-title">种草文案</text>
          <text class="link" data-id="{{item.id}}" bindtap="copyCaption">一键复制</text>
        </view>
        <text class="caption-body" user-select>{{item.caption}}</text>
      </view>

    </block>
  </view>
</view>
