.page {
  min-height: 100vh;
  background: #f5f2ef;
  padding: 20rpx 16rpx 56rpx;
  box-sizing: border-box;
}
.head {
  padding: 8rpx 8rpx 20rpx;
}
.head-title {
  font-size: 34rpx;
  font-weight: 650;
  color: #1f1a17;
  line-height: 1.3;
}
.head-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8178;
}
/* 瀑布流双列 */
.waterfall {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.wf-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.cat-card {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(40, 28, 18, 0.05);
  padding: 0;
  margin: 0;
}
.cover {
  width: 100%;
  display: block;
  vertical-align: top;
  background: #efe8e2;
}
.cover-ph {
  width: 100%;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b5aea8;
  font-size: 24rpx;
  background: #efe8e2;
}
.body {
  padding: 16rpx 18rpx 20rpx;
}
.style {
  font-size: 24rpx;
  font-weight: 560;
  color: #2a2420;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.price {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #c45c26;
  letter-spacing: 0.4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.price.muted {
  color: #9a918a;
  font-weight: 500;
  font-size: 26rpx;
}
.empty {
  margin-top: 120rpx;
  text-align: center;
  padding: 40rpx;
}
.empty-title {
  font-size: 30rpx;
  color: #3a322c;
  font-weight: 560;
}
.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a918a;
}
.footer {
  text-align: center;
  padding: 28rpx 0 8rpx;
  font-size: 24rpx;
  color: #9a918a;
}
