<view class="container">
  <view class="card head">
    <view class="section-title">询价</view>
    <view class="muted">待沟通 → 我来沟通 → 沟通完成；列表显示处理人</view>
  </view>
  <scroll-view scroll-x class="chips-row" enable-flex>
    <text
      class="chip {{status===item.id?'active':''}}"
      wx:for="{{statusChips}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onStatus"
    >{{item.name}}</text>
  </scroll-view>
  <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view>{{item.title}}</view>
    <view class="muted" wx:if="{{item.contactName || item.phone}}">{{item.contactName || ''}} {{item.phone || ''}}</view>
    <view class="muted">处理人：{{item.handlerText}}</view>
    <view class="muted">{{item.statusLabel}} · {{item.content}}</view>
    <view class="muted" wx:if="{{item.handledNote}}">沟通：{{item.handledNote}}</view>
  </view>
  <view class="card muted" wx:if="{{loading && !list.length}}">加载中…</view>
  <view class="card muted empty" wx:elif="{{!list.length}}">
    <view wx:if="{{status==='open'}}">暂无待沟通询价</view>
    <view wx:else>暂无询价</view>
  </view>
  <view class="card muted footer-tip" wx:if="{{loadingMore}}">加载更多…</view>
  <view class="card muted footer-tip" wx:elif="{{list.length && !hasMore}}">没有更多了</view>
  <view class="card muted footer-tip" wx:elif="{{list.length && hasMore}}">上拉加载更多</view>
</view>
