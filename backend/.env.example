# ========== 服务 ==========
PORT=3000
NODE_ENV=development
# 对外访问基址（Nginx 反代后的 HTTPS 域名）；API 路径保持 /api/*
APP_BASE_URL=https://xingma.visitworld.me

# ========== 微信小程序 ==========
# 默认租户 AppID（星马档口），与 migrations/003 种子一致
WECHAT_APP_ID=wx394d23ea099d8a01
# AppSecret：在 mp.weixin.qq.com → 开发管理 → 开发设置 获取。
# 只放在服务器 .env 或 tenants.wx_app_secret，绝不提交到仓库。留空时生产登录会返回明确报错。
WECHAT_APP_SECRET=
# true：跳过 jscode2session，用 code 派生假 openid（仅本地开发！生产必须 false）
DEV_FAKE_LOGIN=false

# ========== MySQL（DB_ENABLED=true 时生效；false 用内存仓库） ==========
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wool
DB_PASSWORD=please_change
DB_NAME=wool_stall

# ========== Redis（会话/限流预留，暂未使用） ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== JWT ==========
# 生产必须换成随机长串：openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# ========== 限制分享名额（designated_only）==========
# 前 N 位成功打开链接的客户可查看；公开分享不受此限制
SHARE_LIMIT_SLOTS=5

# ========== 对象存储（mock|aliyun|cos） ==========
# mock/local：URL 形如 ${MEDIA_PUBLIC_BASE|/APP}/media/tenants/...
# aliyun：仍写本地 storage/ 供 OCR；同步 put 到 OSS，返回 OSS 公网 URL
OSS_PROVIDER=mock
OSS_REGION=oss-cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=
OSS_PREFIX=xingma-stall
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 兼容 ChatHub 风格别名（可选 fallback）
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_REGION=
# ALIYUN_OSS_ENDPOINT=
# ALIYUN_OSS_PREFIX=
# 公开读模式（当前档口）：桶/对象 public-read，API 返回永久公网 URL（无 Signature）
# 若改回私有桶：OSS_PUBLIC_READ=0 + OSS_OBJECT_ACL=private，读链接走短时签名
OSS_PUBLIC_READ=1
OSS_OBJECT_ACL=public-read
# 私有桶签名 TTL（仅 OSS_PUBLIC_READ=0 时使用）；兼容旧名 OSS_SIGNED_TTL
OSS_SIGNED_URL_EXPIRES=3600
OSS_SIGNED_TTL=3600
# 公开读基址（可选，缺省用 bucket.endpoint）；MEDIA_SERVE_LOCAL=1 时强制走本机 /media/
MEDIA_PUBLIC_BASE=https://xy-tradex.oss-cn-shenzhen.aliyuncs.com
MEDIA_SERVE_LOCAL=0

# 商品生图（OpenAI 兼容）
IMAGE_GEN_BASE_URL=https://image.aijws.com/v1
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-2-free
IMAGE_GEN_REF_MODE=task,edits
IMAGE_GEN_CONCURRENCY=2
IMAGE_GEN_TIMEOUT_MS=300000

# 多模态看图选封面（OpenAI 兼容）；密钥只放服务器 .env，勿进小程序/勿 commit
VISION_BASE_URL=https://api.xytoken.xyb2b.com/v1
VISION_API_KEY=
VISION_MODEL=Aerith-haiku-5.5
VISION_TIMEOUT_MS=60000
# 模型最大输出 tokens：思考型模型 reasoning 计入输出预算，不足会导致 content 为空
VISION_MAX_OUTPUT_TOKENS=8192
# 吊牌图 OCR 单独超时（毫秒），默认 90000；超时后走 tesseract 兜底
VISION_HANGTAG_TIMEOUT_MS=90000
VISION_MAX_CANDIDATES=12
VISION_OCR_CONCURRENCY=3
# 仅本机 Mac 调试可开；线上 Linux 必须保持关闭（勿依赖 scripts/vision_ocr）
ENABLE_MAC_VISION_OCR=0

# 通用异步任务（MySQL jobs 表）
JOB_SCHEDULER=true
JOB_CONCURRENCY=4
JOB_POLL_MS=1500
JOB_AUTO_RETRY=true
# 无进度更新的 running 超过此时长视为陈旧并重排队（默认 45min）
JOB_STALE_MS=2700000
DEFAULT_PRODUCT_LEVEL_ID=pl_open

# 宣传视频引擎：lkb（默认，若已配置 LKB key）| xytoken（Seedance 兜底）
# VIDEO_ENGINE=lkb

# LKB Agent 异步视频（sinan-video-generator）
# VIDEO_LKB_AGENT_BASE_URL=https://api-lkb-agent-test.demo.xyb2b.com
# VIDEO_LKB_AGENT_TENANT_ID=5
# VIDEO_LKB_AGENT_CODE=sinan-video-generator
# VIDEO_LKB_AGENT_KEY=          # 或 LKB_AGENT_CALL_KEY=
# VIDEO_LKB_AGENT_KEY_FILE=.secrets/lkb-video-agent.key
# VIDEO_LKB_RATIO=9:16
# VIDEO_LKB_RESOLUTION=720p
# VIDEO_LKB_TIMEOUT_MS=600000
# VIDEO_LKB_POLL_MS=5000
# 传给 LKB/Seedance 的参考图上限（默认 1=仅首帧；多图易触发 fixed channel unavailable）
# VIDEO_LKB_MAX_REF_IMAGES=1  # first_frame preferred; multi-ref hits Seedance channel limits
# 单次 generate 内对瞬时错误（通道繁忙/OSS 上传）的再投次数
# VIDEO_LKB_SUBMIT_RETRIES=3

# xytoken 兜底（OpenAI 兼容 /v1/videos；默认复用 VISION_*）
# VIDEO_GEN_BASE_URL=   # 缺省 = VISION_BASE_URL
# VIDEO_GEN_API_KEY=    # 缺省 = VISION_API_KEY
VIDEO_GEN_MODEL=doubao-seedance-2-5-260628
VIDEO_GEN_SECONDS=10
VIDEO_GEN_SIZE=720x1280
VIDEO_GEN_TIMEOUT_MS=600000
VIDEO_GEN_POLL_MS=5000

# ---------- 外部穿搭工作流 Agent（LKB，与自建羊毛衫流程并存）----------
# POST {OUTFIT_AGENT_BASE_URL}/api/invocations/sync
# Authorization: Bearer <OUTFIT_AGENT_API_KEY>  （或读 OUTFIT_AGENT_API_KEY_FILE）
# Token 只放本机 backend/.env 或 backend/.secrets/，禁止写入仓库
OUTFIT_AGENT_ENABLED=false
OUTFIT_AGENT_BASE_URL=http://api-lkb-agent.pymsfz.cn
OUTFIT_AGENT_API_KEY=
# 兼容别名：LKB_AGENT_TOKEN=
# OUTFIT_AGENT_API_KEY_FILE=.secrets/outfit-agent.key
# 也可把 KEY=value 放在 .secrets/lkb-agent.env（不入仓）
OUTFIT_AGENT_CODE=ai-adaptive-outfit-workflow
OUTFIT_AGENT_TIMEOUT_MS=300000
# 生图引擎：self=自建羊毛衫 | external=仅外部 Agent | both=同图双跑对比
OUTFIT_ENGINE=external
# 同 job 内多槽/多色外部 Agent 并发（默认 3，上限建议 2～3）
OUTFIT_SLOT_CONCURRENCY=3

# 吊牌 OCR 本地兜底（生产建议安装 tesseract-ocr + tesseract-ocr-chi-sim）
TESSERACT_PATH=tesseract
